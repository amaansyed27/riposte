{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "riposte-iota.vercel.app"
          }
        }
      ],
      "destination": "https://riposte.amaansyed27.dev/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "riposte-amaan-syeds-projects.vercel.app"
          }
        }
      ],
      "destination": "https://riposte.amaansyed27.dev/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "riposte-git-main-amaan-syeds-projects.vercel.app"
          }
        }
      ],
      "destination": "https://riposte.amaansyed27.dev/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(og.jpg|press/.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
